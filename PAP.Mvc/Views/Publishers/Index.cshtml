@model System.Collections.Generic.IEnumerable<PAP.DataAccess.Publisher>
@using System.Linq
@using System.Globalization
@using PAP.DataAccess

@{
    ViewBag.Title = "Editoriales";
    var publishers = (Model ?? Enumerable.Empty<Publisher>()).ToList();
    var formPublisher = ViewBag.Form as Publisher ?? new Publisher();
    string openModal = ViewBag.OpenModal as string;
    bool editing = openModal == "edit";
    string successMessage = TempData["Success"] as string;
    string errorMessage = TempData["Error"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 mb-3">
    <div>
        <h1 class="h3 mb-1">Editoriales</h1>
        <p class="text-muted mb-0">Administre las editoriales de los libros.</p>
    </div>
    <button type="button" id="add-publisher-button" class="btn btn-primary">
        Agregar editorial
    </button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div id="publisher-page-error" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>

<p class="text-muted">
    @publishers.Count @(publishers.Count == 1 ? "editorial registrada" : "editoriales registradas")
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption class="visually-hidden">Listado de editoriales y acciones disponibles.</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">País</th>
                <th scope="col">Sitio web</th>
                <th scope="col">Correo</th>
                <th scope="col">Creación (UTC)</th>
                <th scope="col">Editar</th>
                <th scope="col">Eliminar</th>
                <th scope="col">Detalle</th>
            </tr>
        </thead>
        <tbody>
            @if (publishers.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        No hay editoriales registradas. Puede agregar la primera con el botón superior.
                    </td>
                </tr>
            }
            else
            {
                foreach (var publisher in publishers)
                {
                    <tr>
                        <td>@publisher.Id</td>
                        <td class="text-break">@publisher.Name</td>
                        <td class="text-break">@(string.IsNullOrWhiteSpace(publisher.Country) ? "Sin especificar" : publisher.Country)</td>
                        <td class="text-break" style="max-width: 16rem;">@(string.IsNullOrWhiteSpace(publisher.Website) ? "Sin sitio web" : publisher.Website)</td>
                        <td class="text-break" style="max-width: 16rem;">@(string.IsNullOrWhiteSpace(publisher.Email) ? "Sin correo" : publisher.Email)</td>
                        <td class="text-nowrap">@publisher.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary js-publisher-action"
                                    data-action="edit" data-publisher-id="@publisher.Id"
                                    aria-label="Editar editorial @publisher.Name">
                                Editar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger js-publisher-action"
                                    data-action="delete" data-publisher-id="@publisher.Id"
                                    aria-label="Eliminar editorial @publisher.Name">
                                Eliminar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary js-publisher-action"
                                    data-action="details" data-publisher-id="@publisher.Id"
                                    aria-label="Ver detalle de la editorial @publisher.Name">
                                Detalle
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="publisher-form-modal" tabindex="-1"
     aria-labelledby="publisher-form-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" id="publisher-form" method="post"
              action="@Url.Action(editing ? "Edit" : "Create", "Publishers")"
              data-create-url="@Url.Action("Create", "Publishers")"
              data-edit-url="@Url.Action("Edit", "Publishers")"
              data-details-url="@Url.Action("Details", "Publishers")"
              data-open-mode="@openModal">
            @Html.AntiForgeryToken()
            @Html.Hidden("Id", formPublisher.Id, new { id = "publisher-id" })
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="publisher-form-title">@(editing ? "Editar editorial" : "Agregar editorial")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @Html.ValidationSummary(false, "", new { @class = "text-danger", id = "publisher-validation", role = "alert" })

                <div class="mb-3">
                    <label for="publisher-name" class="form-label">Nombre</label>
                    @Html.TextBox("Name", formPublisher.Name, new
                    {
                        @class = "form-control",
                        id = "publisher-name",
                        maxlength = 200,
                        required = "required",
                        aria_describedby = "publisher-name-help"
                    })
                    <div id="publisher-name-help" class="form-text">Máximo 200 caracteres.</div>
                    @Html.ValidationMessage("Name", "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="publisher-country" class="form-label">País (opcional)</label>
                    @Html.TextBox("Country", formPublisher.Country, new
                    {
                        @class = "form-control",
                        id = "publisher-country",
                        maxlength = 100,
                        aria_describedby = "publisher-country-help"
                    })
                    <div id="publisher-country-help" class="form-text">Máximo 100 caracteres.</div>
                    @Html.ValidationMessage("Country", "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="publisher-website" class="form-label">Sitio web (opcional)</label>
                    @Html.TextBox("Website", formPublisher.Website, new
                    {
                        @class = "form-control",
                        id = "publisher-website",
                        type = "url",
                        maxlength = 255,
                        placeholder = "https://editorial.example",
                        aria_describedby = "publisher-website-help"
                    })
                    <div id="publisher-website-help" class="form-text">Use http:// o https://. Máximo 255 caracteres.</div>
                    @Html.ValidationMessage("Website", "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="publisher-email" class="form-label">Correo electrónico (opcional)</label>
                    @Html.TextBox("Email", formPublisher.Email, new
                    {
                        @class = "form-control",
                        id = "publisher-email",
                        type = "email",
                        maxlength = 150,
                        placeholder = "contacto@example.com",
                        aria_describedby = "publisher-email-help"
                    })
                    <div id="publisher-email-help" class="form-text">Máximo 150 caracteres.</div>
                    @Html.ValidationMessage("Email", "", new { @class = "text-danger" })
                </div>

                <p class="text-muted small mb-0">La fecha de creación se asigna automáticamente y se muestra en UTC.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="publisher-save-button">@(editing ? "Guardar cambios" : "Agregar")</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="publisher-details-modal" tabindex="-1"
     aria-labelledby="publisher-details-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="publisher-details-title">Detalle de la editorial</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <dl class="mb-0">
                    <dt>ID</dt>
                    <dd id="publisher-detail-id"></dd>
                    <dt>Nombre</dt>
                    <dd id="publisher-detail-name" class="text-break"></dd>
                    <dt>País</dt>
                    <dd id="publisher-detail-country" class="text-break"></dd>
                    <dt>Sitio web</dt>
                    <dd id="publisher-detail-website" class="text-break"></dd>
                    <dt>Correo electrónico</dt>
                    <dd id="publisher-detail-email" class="text-break"></dd>
                    <dt>Fecha de creación (UTC)</dt>
                    <dd id="publisher-detail-created-at"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="publisher-delete-modal" tabindex="-1"
     aria-labelledby="publisher-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="publisher-delete-form" method="post"
              action="@Url.Action("Delete", "Publishers")">
            @Html.AntiForgeryToken()
            <input type="hidden" id="publisher-delete-id" name="id" />
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="publisher-delete-title">Eliminar editorial</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea eliminar la editorial <strong id="publisher-delete-name" class="text-break"></strong>?</p>
                <p class="text-muted mb-0">Las editoriales que tengan libros asociados no se pueden eliminar.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger" id="publisher-delete-button">Eliminar</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
                (function () {
                    "use strict";

                    const form = document.getElementById("publisher-form");
                    const nameInput = document.getElementById("publisher-name");
                    const countryInput = document.getElementById("publisher-country");
                    const websiteInput = document.getElementById("publisher-website");
                    const emailInput = document.getElementById("publisher-email");
                    const idInput = document.getElementById("publisher-id");
                    const title = document.getElementById("publisher-form-title");
                    const saveButton = document.getElementById("publisher-save-button");
                    const pageError = document.getElementById("publisher-page-error");
                    const newButton = document.getElementById("add-publisher-button");
                    const actionButtons = document.querySelectorAll(".js-publisher-action");
                    const formModalElement = document.getElementById("publisher-form-modal");
                    const formModal = bootstrap.Modal.getOrCreateInstance(formModalElement);
                    const detailsModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("publisher-details-modal"));
                    const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("publisher-delete-modal"));
                    const deleteForm = document.getElementById("publisher-delete-form");
                    const deleteButton = document.getElementById("publisher-delete-button");
                    let loading = false;
                    let formMode = form.dataset.openMode === "edit" ? "edit" : "create";

                    function setFormMode(mode) {
                        formMode = mode;
                        form.action = mode === "edit" ? form.dataset.editUrl : form.dataset.createUrl;
                        title.textContent = mode === "edit" ? "Editar editorial" : "Agregar editorial";
                        saveButton.textContent = mode === "edit" ? "Guardar cambios" : "Agregar";
                        saveButton.disabled = false;
                    }

                    function clearFormErrors() {
                        const summary = document.getElementById("publisher-validation");
                        if (summary) {
                            summary.classList.add("d-none");
                        }
                        form.querySelectorAll(".input-validation-error").forEach(function (element) {
                            element.classList.remove("input-validation-error");
                        });
                        form.querySelectorAll("[data-valmsg-for]").forEach(function (element) {
                            element.textContent = "";
                            element.classList.remove("field-validation-error");
                        });
                    }

                    function showPageError(message) {
                        pageError.textContent = message;
                        pageError.classList.remove("d-none");
                        pageError.focus();
                    }

                    function setLoading(value) {
                        loading = value;
                        newButton.disabled = value;
                        actionButtons.forEach(function (button) {
                            button.disabled = value;
                        });
                    }

                    async function loadPublisher(id) {
                        let response;
                        try {
                            response = await fetch(form.dataset.detailsUrl + "?id=" + encodeURIComponent(id), {
                                cache: "no-store",
                                headers: { "Accept": "application/json" }
                            });
                        } catch (error) {
                            throw new Error("No se pudo conectar con el sistema. Inténtelo de nuevo.");
                        }

                        if (!response.ok) {
                            throw new Error(response.status === 404
                                ? "La editorial ya no existe. Actualice la página."
                                : "No se pudo consultar la editorial. Inténtelo de nuevo.");
                        }

                        try {
                            return await response.json();
                        } catch (error) {
                            throw new Error("No se pudo leer la información de la editorial. Actualice la página.");
                        }
                    }

                    newButton.addEventListener("click", function () {
                        form.reset();
                        idInput.value = "0";
                        nameInput.value = "";
                        countryInput.value = "";
                        websiteInput.value = "";
                        emailInput.value = "";
                        clearFormErrors();
                        pageError.classList.add("d-none");
                        setFormMode("create");
                        formModal.show();
                    });

                    actionButtons.forEach(function (button) {
                        button.addEventListener("click", async function () {
                            if (loading) {
                                return;
                            }

                            setLoading(true);
                            pageError.classList.add("d-none");

                            try {
                                const publisher = await loadPublisher(button.dataset.publisherId);

                                if (button.dataset.action === "edit") {
                                    form.reset();
                                    idInput.value = publisher.Id;
                                    nameInput.value = publisher.Name;
                                    countryInput.value = publisher.Country || "";
                                    websiteInput.value = publisher.Website || "";
                                    emailInput.value = publisher.Email || "";
                                    clearFormErrors();
                                    setFormMode("edit");
                                    formModal.show();
                                } else if (button.dataset.action === "details") {
                                    document.getElementById("publisher-detail-id").textContent = publisher.Id;
                                    document.getElementById("publisher-detail-name").textContent = publisher.Name;
                                    document.getElementById("publisher-detail-country").textContent = publisher.Country || "Sin especificar";
                                    document.getElementById("publisher-detail-website").textContent = publisher.Website || "Sin sitio web";
                                    document.getElementById("publisher-detail-email").textContent = publisher.Email || "Sin correo";
                                    document.getElementById("publisher-detail-created-at").textContent = publisher.CreatedAt;
                                    detailsModal.show();
                                } else if (button.dataset.action === "delete") {
                                    document.getElementById("publisher-delete-id").value = publisher.Id;
                                    document.getElementById("publisher-delete-name").textContent = publisher.Name;
                                    deleteButton.disabled = false;
                                    deleteButton.textContent = "Eliminar";
                                    deleteModal.show();
                                }
                            } catch (error) {
                                showPageError(error.message);
                            } finally {
                                setLoading(false);
                            }
                        });
                    });

                    formModalElement.addEventListener("shown.bs.modal", function () {
                        nameInput.focus();
                    });

                    form.addEventListener("submit", function () {
                        saveButton.disabled = true;
                        saveButton.textContent = "Guardando…";
                    });

                    deleteForm.addEventListener("submit", function () {
                        deleteButton.disabled = true;
                        deleteButton.textContent = "Eliminando…";
                    });

                    window.addEventListener("pageshow", function () {
                        setFormMode(formMode);
                        deleteButton.disabled = false;
                        deleteButton.textContent = "Eliminar";
                        setLoading(false);
                    });

                    setFormMode(formMode);
                    if (form.dataset.openMode === "create" || form.dataset.openMode === "edit") {
                        formModal.show();
                    }
                })();
    </script>
}
