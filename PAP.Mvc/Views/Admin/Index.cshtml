@model System.Collections.Generic.IEnumerable<PAP.Generators.GenerationStatus>
@using System.Linq
@using PAP.Generators

@{
    ViewBag.Title = "Admin";
    var states = (Model ?? Enumerable.Empty<GenerationStatus>()).ToList();
    string successMessage = TempData["Success"] as string;
    string errorMessage = TempData["Error"] as string;
}

<div class="mt-4 mb-3">
    <h1 class="h3 mb-1">Administracion de datos</h1>
    <p class="text-muted mb-0">Generador de registros de pruebas.</p>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="alert alert-info">
    Las tablas deben estar vacias para generar datos.
</div>

<p class="text-muted">@states.Count entidades - @states.Count(s => s.CanGenerate) disponibles para generar</p>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <caption class="visually-hidden">Entidades, requisitos y generación de datos.</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">Entidad</th>
                <th scope="col">Generar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var state in states)
            {
                <tr>
                    <td>
                        <strong>@state.DisplayName</strong>
                        <div class="small text-muted">dbo.@state.EntityName</div>
                    </td>
                    <td>
                        <div class="mb-2">
                            <span class="badge @(state.CanGenerate ? "bg-success" : "bg-secondary")">@state.StateLabel</span>
                            <span class="small text-muted">@state.Message</span>
                        </div>
                        @if (state.CanGenerate)
                        {
                            <form method="post" action="@Url.Action("Generate", "Admin")"
                                  class="d-flex flex-wrap align-items-end gap-2 js-generation-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="entityName" value="@state.EntityName" />
                                <div>
                                    <label for="count-@state.EntityName" class="form-label small mb-1">Cantidad</label>
                                    <input type="number" class="form-control form-control-sm" style="width: 7rem;"
                                           id="count-@state.EntityName" name="count" min="1"
                                           max="@GenerationService.MaxBatchSize" value="20" required />
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm"
                                        aria-label="Generar datos de @state.DisplayName">Generar</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm" disabled
                                    aria-label="Generación bloqueada para @state.DisplayName">Generar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section scripts {
    <script>
        document.querySelectorAll(".js-generation-form").forEach(function (form) {
            form.addEventListener("submit", function () {
                const button = form.querySelector("button[type=submit]");
                button.disabled = true;
                button.textContent = "Generando…";
            });
        });
    </script>
}
