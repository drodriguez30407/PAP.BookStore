@model System.Collections.Generic.IEnumerable<PAP.DataAccess.Genre>
@using System.Linq
@using PAP.DataAccess

@{
    ViewBag.Title = "Géneros";
    var genres = (Model ?? Enumerable.Empty<Genre>()).ToList();
    var formGenre = ViewBag.Form as Genre ?? new Genre();
    string openModal = ViewBag.OpenModal as string;
    bool editing = openModal == "edit";
    string successMessage = TempData["Success"] as string;
    string errorMessage = TempData["Error"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 mb-3">
    <div>
        <h1 class="h3 mb-1">Géneros</h1>
        <p class="text-muted mb-0">Administre los géneros de los libros.</p>
    </div>
    <button type="button" id="add-genre-button" class="btn btn-primary">
        Agregar género
    </button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div id="genre-page-error" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>

<p class="text-muted">
    @genres.Count @(genres.Count == 1 ? "género registrado" : "géneros registrados")
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption class="visually-hidden">Listado de géneros y acciones disponibles.</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Descripción</th>
                <th scope="col">Editar</th>
                <th scope="col">Eliminar</th>
                <th scope="col">Detalle</th>
            </tr>
        </thead>
        <tbody>
            @if (genres.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No hay géneros registrados. Puede agregar el primero con el botón superior.
                    </td>
                </tr>
            }
            else
            {
                foreach (var genre in genres)
                {
                    <tr>
                        <td>@genre.Id</td>
                        <td class="text-break">@genre.Name</td>
                        <td class="text-break" style="white-space: pre-wrap; max-width: 30rem;">@(string.IsNullOrWhiteSpace(genre.Description) ? "Sin descripción" : genre.Description)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary js-genre-action"
                                    data-action="edit" data-genre-id="@genre.Id"
                                    aria-label="Editar género @genre.Name">
                                Editar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger js-genre-action"
                                    data-action="delete" data-genre-id="@genre.Id"
                                    aria-label="Eliminar género @genre.Name">
                                Eliminar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary js-genre-action"
                                    data-action="details" data-genre-id="@genre.Id"
                                    aria-label="Ver detalle del género @genre.Name">
                                Detalle
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="genre-form-modal" tabindex="-1"
     aria-labelledby="genre-form-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="genre-form" method="post"
              action="@Url.Action(editing ? "Edit" : "Create", "Genres")"
              data-create-url="@Url.Action("Create", "Genres")"
              data-edit-url="@Url.Action("Edit", "Genres")"
              data-details-url="@Url.Action("Details", "Genres")"
              data-open-mode="@openModal">
            @Html.AntiForgeryToken()
            @Html.Hidden("Id", formGenre.Id, new { id = "genre-id" })
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="genre-form-title">@(editing ? "Editar género" : "Agregar género")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @Html.ValidationSummary(false, "", new { @class = "text-danger", id = "genre-validation", role = "alert" })

                <div class="mb-3">
                    <label for="genre-name" class="form-label">Nombre</label>
                    @Html.TextBox("Name", formGenre.Name, new
                    {
                        @class = "form-control",
                        id = "genre-name",
                        maxlength = 100,
                        required = "required",
                        aria_describedby = "genre-name-help"
                    })
                    <div id="genre-name-help" class="form-text">Máximo 100 caracteres.</div>
                    @Html.ValidationMessage("Name", "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="genre-description" class="form-label">Descripción (opcional)</label>
                    @Html.TextArea("Description", formGenre.Description, new
                    {
                        @class = "form-control",
                        id = "genre-description",
                        rows = 4,
                        maxlength = 500,
                        aria_describedby = "genre-description-help"
                    })
                    <div id="genre-description-help" class="form-text">Máximo 500 caracteres.</div>
                    @Html.ValidationMessage("Description", "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="genre-save-button">@(editing ? "Guardar cambios" : "Agregar")</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="genre-details-modal" tabindex="-1"
     aria-labelledby="genre-details-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="genre-details-title">Detalle del género</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <dl class="mb-0">
                    <dt>ID</dt>
                    <dd id="genre-detail-id"></dd>
                    <dt>Nombre</dt>
                    <dd id="genre-detail-name" class="text-break"></dd>
                    <dt>Descripción</dt>
                    <dd id="genre-detail-description" class="text-break" style="white-space: pre-wrap;"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="genre-delete-modal" tabindex="-1"
     aria-labelledby="genre-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="genre-delete-form" method="post"
              action="@Url.Action("Delete", "Genres")">
            @Html.AntiForgeryToken()
            <input type="hidden" id="genre-delete-id" name="id" />
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="genre-delete-title">Eliminar género</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea eliminar el género <strong id="genre-delete-name" class="text-break"></strong>?</p>
                <p class="text-muted mb-0">Los géneros que tengan libros asociados no se pueden eliminar.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger" id="genre-delete-button">Eliminar</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
                (function () {
                    "use strict";

                    const form = document.getElementById("genre-form");
                    const nameInput = document.getElementById("genre-name");
                    const descriptionInput = document.getElementById("genre-description");
                    const idInput = document.getElementById("genre-id");
                    const title = document.getElementById("genre-form-title");
                    const saveButton = document.getElementById("genre-save-button");
                    const pageError = document.getElementById("genre-page-error");
                    const newButton = document.getElementById("add-genre-button");
                    const actionButtons = document.querySelectorAll(".js-genre-action");
                    const formModalElement = document.getElementById("genre-form-modal");
                    const formModal = bootstrap.Modal.getOrCreateInstance(formModalElement);
                    const detailsModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("genre-details-modal"));
                    const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("genre-delete-modal"));
                    const deleteForm = document.getElementById("genre-delete-form");
                    const deleteButton = document.getElementById("genre-delete-button");
                    let loading = false;
                    let formMode = form.dataset.openMode === "edit" ? "edit" : "create";

                    function setFormMode(mode) {
                        formMode = mode;
                        form.action = mode === "edit" ? form.dataset.editUrl : form.dataset.createUrl;
                        title.textContent = mode === "edit" ? "Editar género" : "Agregar género";
                        saveButton.textContent = mode === "edit" ? "Guardar cambios" : "Agregar";
                        saveButton.disabled = false;
                    }

                    function clearFormErrors() {
                        const summary = document.getElementById("genre-validation");
                        if (summary) {
                            summary.classList.add("d-none");
                        }
                        form.querySelectorAll(".input-validation-error").forEach(function (element) {
                            element.classList.remove("input-validation-error");
                        });
                        form.querySelectorAll("[data-valmsg-for]").forEach(function (element) {
                            element.textContent = "";
                            element.classList.remove("field-validation-error");
                        });
                    }

                    function showPageError(message) {
                        pageError.textContent = message;
                        pageError.classList.remove("d-none");
                        pageError.focus();
                    }

                    function setLoading(value) {
                        loading = value;
                        newButton.disabled = value;
                        actionButtons.forEach(function (button) {
                            button.disabled = value;
                        });
                    }

                    async function loadGenre(id) {
                        let response;
                        try {
                            response = await fetch(form.dataset.detailsUrl + "?id=" + encodeURIComponent(id), {
                                cache: "no-store",
                                headers: { "Accept": "application/json" }
                            });
                        } catch (error) {
                            throw new Error("No se pudo conectar con el sistema. Inténtelo de nuevo.");
                        }

                        if (!response.ok) {
                            throw new Error(response.status === 404
                                ? "El género ya no existe. Actualice la página."
                                : "No se pudo consultar el género. Inténtelo de nuevo.");
                        }

                        try {
                            return await response.json();
                        } catch (error) {
                            throw new Error("No se pudo leer la información del género. Actualice la página.");
                        }
                    }

                    newButton.addEventListener("click", function () {
                        form.reset();
                        idInput.value = "0";
                        nameInput.value = "";
                        descriptionInput.value = "";
                        clearFormErrors();
                        pageError.classList.add("d-none");
                        setFormMode("create");
                        formModal.show();
                    });

                    actionButtons.forEach(function (button) {
                        button.addEventListener("click", async function () {
                            if (loading) {
                                return;
                            }

                            setLoading(true);
                            pageError.classList.add("d-none");

                            try {
                                const genre = await loadGenre(button.dataset.genreId);

                                if (button.dataset.action === "edit") {
                                    form.reset();
                                    idInput.value = genre.Id;
                                    nameInput.value = genre.Name;
                                    descriptionInput.value = genre.Description || "";
                                    clearFormErrors();
                                    setFormMode("edit");
                                    formModal.show();
                                } else if (button.dataset.action === "details") {
                                    document.getElementById("genre-detail-id").textContent = genre.Id;
                                    document.getElementById("genre-detail-name").textContent = genre.Name;
                                    document.getElementById("genre-detail-description").textContent = genre.Description || "Sin descripción";
                                    detailsModal.show();
                                } else if (button.dataset.action === "delete") {
                                    document.getElementById("genre-delete-id").value = genre.Id;
                                    document.getElementById("genre-delete-name").textContent = genre.Name;
                                    deleteButton.disabled = false;
                                    deleteButton.textContent = "Eliminar";
                                    deleteModal.show();
                                }
                            } catch (error) {
                                showPageError(error.message);
                            } finally {
                                setLoading(false);
                            }
                        });
                    });

                    formModalElement.addEventListener("shown.bs.modal", function () {
                        nameInput.focus();
                    });

                    form.addEventListener("submit", function () {
                        saveButton.disabled = true;
                        saveButton.textContent = "Guardando…";
                    });

                    deleteForm.addEventListener("submit", function () {
                        deleteButton.disabled = true;
                        deleteButton.textContent = "Eliminando…";
                    });

                    window.addEventListener("pageshow", function () {
                        setFormMode(formMode);
                        deleteButton.disabled = false;
                        deleteButton.textContent = "Eliminar";
                        setLoading(false);
                    });

                    setFormMode(formMode);
                    if (form.dataset.openMode === "create" || form.dataset.openMode === "edit") {
                        formModal.show();
                    }
                })();
    </script>
}
