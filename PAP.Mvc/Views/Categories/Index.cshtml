@model System.Collections.Generic.IEnumerable<PAP.DataAccess.Category>
@using System.Linq
@using PAP.DataAccess

@{
    ViewBag.Title = "Categorías";
    var categories = (Model ?? Enumerable.Empty<Category>()).ToList();
    var formCategory = ViewBag.Form as Category ?? new Category();
    string openModal = ViewBag.OpenModal as string;
    bool editing = openModal == "edit";
    string successMessage = TempData["Success"] as string;
    string errorMessage = TempData["Error"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 mb-3">
    <div>
        <h1 class="h3 mb-1">Categorías</h1>
        <p class="text-muted mb-0">Administre las categorías de los libros.</p>
    </div>
    <button type="button" id="add-category-button" class="btn btn-primary">
        Agregar categoría
    </button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div id="category-page-error" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>

<p class="text-muted">
    @categories.Count @(categories.Count == 1 ? "categoría registrada" : "categorías registradas")
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption class="visually-hidden">Listado de categorías y acciones disponibles.</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Descripción</th>
                <th scope="col">Editar</th>
                <th scope="col">Eliminar</th>
                <th scope="col">Detalle</th>
            </tr>
        </thead>
        <tbody>
            @if (categories.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        No hay categorías registradas. Puede agregar la primera con el botón superior.
                    </td>
                </tr>
            }
            else
            {
                foreach (var category in categories)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td class="text-break">@category.Name</td>
                        <td class="text-break" style="white-space: pre-wrap; max-width: 30rem;">@(string.IsNullOrWhiteSpace(category.Description) ? "Sin descripción" : category.Description)</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary js-category-action"
                                    data-action="edit" data-category-id="@category.Id"
                                    aria-label="Editar categoría @category.Name">
                                Editar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger js-category-action"
                                    data-action="delete" data-category-id="@category.Id"
                                    aria-label="Eliminar categoría @category.Name">
                                Eliminar
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary js-category-action"
                                    data-action="details" data-category-id="@category.Id"
                                    aria-label="Ver detalle de la categoría @category.Name">
                                Detalle
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="category-form-modal" tabindex="-1"
     aria-labelledby="category-form-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="category-form" method="post"
              action="@Url.Action(editing ? "Edit" : "Create", "Categories")"
              data-create-url="@Url.Action("Create", "Categories")"
              data-edit-url="@Url.Action("Edit", "Categories")"
              data-details-url="@Url.Action("Details", "Categories")"
              data-open-mode="@openModal">
            @Html.AntiForgeryToken()
            @Html.Hidden("Id", formCategory.Id, new { id = "category-id" })
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="category-form-title">@(editing ? "Editar categoría" : "Agregar categoría")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @Html.ValidationSummary(false, "", new { @class = "text-danger", id = "category-validation", role = "alert" })

                <div class="mb-3">
                    <label for="category-name" class="form-label">Nombre</label>
                    @Html.TextBox("Name", formCategory.Name, new
                    {
                        @class = "form-control",
                        id = "category-name",
                        maxlength = 100,
                        required = "required",
                        aria_describedby = "category-name-help"
                    })
                    <div id="category-name-help" class="form-text">Máximo 100 caracteres.</div>
                    @Html.ValidationMessage("Name", "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label for="category-description" class="form-label">Descripción (opcional)</label>
                    @Html.TextArea("Description", formCategory.Description, new
                    {
                        @class = "form-control",
                        id = "category-description",
                        rows = 4,
                        maxlength = 500,
                        aria_describedby = "category-description-help"
                    })
                    <div id="category-description-help" class="form-text">Máximo 500 caracteres.</div>
                    @Html.ValidationMessage("Description", "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="category-save-button">@(editing ? "Guardar cambios" : "Agregar")</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="category-details-modal" tabindex="-1"
     aria-labelledby="category-details-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="category-details-title">Detalle de la categoría</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <dl class="mb-0">
                    <dt>ID</dt>
                    <dd id="category-detail-id"></dd>
                    <dt>Nombre</dt>
                    <dd id="category-detail-name" class="text-break"></dd>
                    <dt>Descripción</dt>
                    <dd id="category-detail-description" class="text-break" style="white-space: pre-wrap;"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="category-delete-modal" tabindex="-1"
     aria-labelledby="category-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="category-delete-form" method="post"
              action="@Url.Action("Delete", "Categories")">
            @Html.AntiForgeryToken()
            <input type="hidden" id="category-delete-id" name="id" />
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="category-delete-title">Eliminar categoría</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Desea eliminar la categoría <strong id="category-delete-name" class="text-break"></strong>?</p>
                <p class="text-muted mb-0">Las categorías que tengan libros asociados no se pueden eliminar.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger" id="category-delete-button">Eliminar</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>(function () {
            "use strict";

            const form = document.getElementById("category-form");
            const nameInput = document.getElementById("category-name");
            const descriptionInput = document.getElementById("category-description");
            const idInput = document.getElementById("category-id");
            const title = document.getElementById("category-form-title");
            const saveButton = document.getElementById("category-save-button");
            const pageError = document.getElementById("category-page-error");
            const newButton = document.getElementById("add-category-button");
            const actionButtons = document.querySelectorAll(".js-category-action");
            const formModalElement = document.getElementById("category-form-modal");
            const formModal = bootstrap.Modal.getOrCreateInstance(formModalElement);
            const detailsModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("category-details-modal"));
            const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("category-delete-modal"));
            const deleteForm = document.getElementById("category-delete-form");
            const deleteButton = document.getElementById("category-delete-button");
            let loading = false;
            let formMode = form.dataset.openMode === "edit" ? "edit" : "create";

            function setFormMode(mode) {
                formMode = mode;
                form.action = mode === "edit" ? form.dataset.editUrl : form.dataset.createUrl;
                title.textContent = mode === "edit" ? "Editar categoría" : "Agregar categoría";
                saveButton.textContent = mode === "edit" ? "Guardar cambios" : "Agregar";
                saveButton.disabled = false;
            }

            function clearFormErrors() {
                const summary = document.getElementById("category-validation");
                if (summary) {
                    summary.classList.add("d-none");
                }
                form.querySelectorAll(".input-validation-error").forEach(function (element) {
                    element.classList.remove("input-validation-error");
                });
                form.querySelectorAll("[data-valmsg-for]").forEach(function (element) {
                    element.textContent = "";
                    element.classList.remove("field-validation-error");
                });
            }

            function showPageError(message) {
                pageError.textContent = message;
                pageError.classList.remove("d-none");
                pageError.focus();
            }

            function setLoading(value) {
                loading = value;
                newButton.disabled = value;
                actionButtons.forEach(function (button) {
                    button.disabled = value;
                });
            }

            async function loadCategory(id) {
                let response;
                try {
                    response = await fetch(form.dataset.detailsUrl + "?id=" + encodeURIComponent(id), {
                        cache: "no-store",
                        headers: { "Accept": "application/json" }
                    });
                } catch (error) {
                    throw new Error("No se pudo conectar con el sistema. Inténtelo de nuevo.");
                }

                if (!response.ok) {
                    throw new Error(response.status === 404
                        ? "La categoría ya no existe. Actualice la página."
                        : "No se pudo consultar la categoría. Inténtelo de nuevo.");
                }

                try {
                    return await response.json();
                } catch (error) {
                    throw new Error("No se pudo leer la información de la categoría. Actualice la página.");
                }
            }

            newButton.addEventListener("click", function () {
                form.reset();
                idInput.value = "0";
                nameInput.value = "";
                descriptionInput.value = "";
                clearFormErrors();
                pageError.classList.add("d-none");
                setFormMode("create");
                formModal.show();
            });

            actionButtons.forEach(function (button) {
                button.addEventListener("click", async function () {
                    if (loading) {
                        return;
                    }

                    setLoading(true);
                    pageError.classList.add("d-none");

                    try {
                        const category = await loadCategory(button.dataset.categoryId);

                        if (button.dataset.action === "edit") {
                            form.reset();
                            idInput.value = category.Id;
                            nameInput.value = category.Name;
                            descriptionInput.value = category.Description || "";
                            clearFormErrors();
                            setFormMode("edit");
                            formModal.show();
                        } else if (button.dataset.action === "details") {
                            document.getElementById("category-detail-id").textContent = category.Id;
                            document.getElementById("category-detail-name").textContent = category.Name;
                            document.getElementById("category-detail-description").textContent = category.Description || "Sin descripción";
                            detailsModal.show();
                        } else if (button.dataset.action === "delete") {
                            document.getElementById("category-delete-id").value = category.Id;
                            document.getElementById("category-delete-name").textContent = category.Name;
                            deleteButton.disabled = false;
                            deleteButton.textContent = "Eliminar";
                            deleteModal.show();
                        }
                    } catch (error) {
                        showPageError(error.message);
                    } finally {
                        setLoading(false);
                    }
                });
            });

            formModalElement.addEventListener("shown.bs.modal", function () {
                nameInput.focus();
            });

            form.addEventListener("submit", function () {
                saveButton.disabled = true;
                saveButton.textContent = "Guardando…";
            });

            deleteForm.addEventListener("submit", function () {
                deleteButton.disabled = true;
                deleteButton.textContent = "Eliminando…";
            });

            window.addEventListener("pageshow", function () {
                setFormMode(formMode);
                deleteButton.disabled = false;
                deleteButton.textContent = "Eliminar";
                setLoading(false);
            });

            setFormMode(formMode);
            if (form.dataset.openMode === "create" || form.dataset.openMode === "edit") {
                formModal.show();
            }
        })();</script>
}
